# Copy to .env and adjust. Only VITE_-prefixed, non-secret values belong here:
# everything in this file is shipped to the browser.

# Base URL of the FL-Healthcare API.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project (leave empty to use the backend's built-in demo sign-in).
# Use the *anon* (public) key here. Never put the service-role key in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: map tiles shown under real region boundaries (not used for the simulated map).
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
