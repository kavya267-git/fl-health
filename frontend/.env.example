# Copy to .env and adjust. Only VITE_-prefixed, non-secret values belong here:
# everything in this file is shipped to the browser.

# Base URL of the MediFed API.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project (leave empty to use the backend's built-in demo sign-in).
# Use the *anon* (public) key here. Never put the service-role key in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: base-map tiles under real region boundaries (never under the simulated map). Leave empty to
# draw the regions on a plain ground. Either way the map is locked to the loaded regions.
# Example: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png with the attribution below.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
