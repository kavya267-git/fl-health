# Line endings: LF in the repository and in every checkout, on every OS, so edits on Windows cannot
# reintroduce CRLF. Binary files are never converted.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.npz binary
*.pt binary
*.pth binary
*.db binary
*.sqlite binary
