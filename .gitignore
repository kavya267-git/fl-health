# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Node
node_modules/
frontend/dist/

# Secrets - never commit real keys
.env
*.env
!.env.example

# Hospital data stays with the hospital node; it is never committed
data/hospitals/
# Each hospital node's saved server address and token (scripts/setup_hospital.py)
data/nodes/

# Raw downloaded datasets (MIT-BIH, PhysioNet, ...): obtain them yourself under their own terms
data/raw/

# Coordinator runtime state (database, model weights, reference cases)
backend/var/
ml/checkpoints/*
!ml/checkpoints/.gitkeep
*.npz
*.pt
*.pth
*.db
*.sqlite*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Experiment scratch partitions (regenerated from configs)
experiments/.work/

# Browser-automation artifacts (screenshots, page snapshots)
.playwright-mcp/

# Per-round experiment logs are large; RESULTS.md and each experiment's summary.csv are committed instead
experiments/results/*/rounds.csv
experiments/results/*/forecasts.csv
