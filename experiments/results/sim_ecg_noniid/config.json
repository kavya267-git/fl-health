{
  "config": {
    "description": "All simulated ECG records are pooled and re-split across the four hospitals with a Dirichlet label split (the same partition_groups function scripts/prepare_real_data.py uses). alpha = inf is an even random split (IID); smaller alpha gives each hospital fewer classes.\n",
    "dataset": {
      "modality": "ecg",
      "source": "simulated",
      "csv": [],
      "scale": 1.0,
      "max_records": null
    },
    "partition": {
      "scheme": "dirichlet",
      "alpha": null,
      "val_fraction": 0.25
    },
    "training": {
      "rounds": 30,
      "local_epochs": 2,
      "batch_size": 32,
      "learning_rate": 0.003,
      "class_weighting": "none",
      "proximal_mu": 0.0
    },
    "dp": {
      "enabled": false,
      "clip_norm": 1.0,
      "noise_multiplier": 0.0,
      "delta": 1e-05
    },
    "methods": [
      "local",
      "fedavg",
      "centralised"
    ],
    "seeds": [
      0,
      1,
      2
    ],
    "target_f1": 0.9,
    "variants": [
      {
        "label": "alpha=inf",
        "partition": {
          "alpha": "inf"
        }
      },
      {
        "label": "alpha=1.0",
        "partition": {
          "alpha": 1.0
        }
      },
      {
        "label": "alpha=0.1",
        "partition": {
          "alpha": 0.1
        }
      }
    ],
    "title": "2. Non-IID label skew: ECG, simulated",
    "name": "sim_ecg_noniid",
    "config_file": "sim_ecg_noniid.yaml"
  },
  "environment": {
    "fl_healthcare": "1.1.0",
    "python": "3.13.2",
    "torch": "2.15.0+cpu",
    "numpy": "2.5.4",
    "platform": "Windows-11-10.0.26200-SP0",
    "cpu_threads": 5
  }
}