{
  "config": {
    "description": "MIT-BIH heartbeats split across four hospitals with a Dirichlet label split, alpha = 1.0 (the default of scripts/prepare_real_data.py). The export has no patient identifiers, so beats of one patient can fall in several hospitals and on both sides of a hospital's train / held-out split; scores are therefore optimistic compared with a patient-wise split.\n",
    "dataset": {
      "modality": "ecg",
      "source": "mit-bih",
      "csv": [
        "data/raw/mitbih/mitbih_train.csv",
        "data/raw/mitbih/mitbih_test.csv"
      ],
      "scale": 1.0,
      "max_records": 25000,
      "subsample_seed": 0
    },
    "partition": {
      "scheme": "dirichlet",
      "alpha": 1.0,
      "val_fraction": 0.25
    },
    "training": {
      "rounds": 20,
      "local_epochs": 2,
      "batch_size": 32,
      "learning_rate": 0.003,
      "class_weighting": "none",
      "proximal_mu": 0.0
    },
    "dp": {
      "enabled": false,
      "clip_norm": 1.0,
      "noise_multiplier": 0.0,
      "delta": 1e-05
    },
    "methods": [
      "local",
      "fedavg",
      "centralised"
    ],
    "seeds": [
      0,
      1,
      2
    ],
    "target_f1": 0.8,
    "variants": [
      {
        "label": "default"
      }
    ],
    "title": "1d. Baselines: ECG, MIT-BIH (real recordings)",
    "name": "mitbih_ecg_baselines",
    "config_file": "mitbih_ecg_baselines.yaml"
  },
  "environment": {
    "fl_healthcare": "1.1.0",
    "python": "3.13.2",
    "torch": "2.15.0+cpu",
    "numpy": "2.5.4",
    "platform": "Windows-11-10.0.26200-SP0",
    "cpu_threads": 5
  }
}