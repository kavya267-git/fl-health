{
  "config": {
    "description": "EHR is imbalanced (about 18% adverse outcomes). Class-weighted cross-entropy is an experiment variable here, not a change to the platform: \"balanced\" weights each class by n / (2 n_class), computed by every hospital from its own training labels (the centralised model uses the union).\n",
    "dataset": {
      "modality": "ehr",
      "source": "simulated",
      "csv": [],
      "scale": 1.0,
      "max_records": null
    },
    "partition": {
      "scheme": "natural",
      "alpha": null,
      "val_fraction": 0.25
    },
    "training": {
      "rounds": 30,
      "local_epochs": 2,
      "batch_size": 32,
      "learning_rate": 0.003,
      "class_weighting": "none",
      "proximal_mu": 0.0
    },
    "dp": {
      "enabled": false,
      "clip_norm": 1.0,
      "noise_multiplier": 0.0,
      "delta": 1e-05
    },
    "methods": [
      "local",
      "fedavg",
      "centralised"
    ],
    "seeds": [
      0,
      1,
      2
    ],
    "target_f1": 0.6,
    "variants": [
      {
        "label": "unweighted loss"
      },
      {
        "label": "class-weighted loss",
        "training": {
          "class_weighting": "balanced"
        }
      }
    ],
    "title": "1b. Baselines: EHR, simulated hospitals, with and without class-weighted loss",
    "name": "sim_ehr_baselines",
    "config_file": "sim_ehr_baselines.yaml"
  },
  "environment": {
    "fl_healthcare": "1.1.0",
    "python": "3.13.2",
    "torch": "2.15.0+cpu",
    "numpy": "2.5.4",
    "platform": "Windows-11-10.0.26200-SP0",
    "cpu_threads": 5
  }
}