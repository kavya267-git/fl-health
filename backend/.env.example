# Copy to backend/.env. Never commit the real file.

# ---------------------------------------------------------------- Mode
# true  : simulated hospitals and data, built-in demo accounts, SQLite. Runs with no external services.
# false : your prepared datasets, Supabase Auth and Supabase Postgres (all required).
DEMO_MODE=true

# in-process : the four hospital nodes run as threads inside the API process.
# external   : each node is its own process (scripts/setup_hospital.py) and calls the API over HTTP.
#              See docs/multi-machine.md for hospitals on separate laptops.
HOSPITAL_NODES=in-process

# auto | pytorch | numpy-reference   (auto = PyTorch models if installed, otherwise the NumPy stand-ins)
ML_BACKEND=auto

# Start the X-ray model from ImageNet weights (downloads them once). Recommended for real images.
XRAY_PRETRAINED=false

# Pause, in seconds, before each simulated hospital delivers an update. Purely for watching a
# round progress in a demo when training itself takes milliseconds. 0 disables it.
DEMO_STEP_DELAY_SECONDS=0

# ---------------------------------------------------------------- Supabase
SUPABASE_URL=
# Server-side only. Never put this key in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Postgres connection string (Project Settings -> Database). Empty = local SQLite in demo mode.
DATABASE_URL=
# Comma-separated emails that become administrators on first sign-in.
ADMIN_EMAILS=

# ---------------------------------------------------------------- Accounts
# true : the sign-in page offers "Create an account". New accounts are always viewers (read-only);
#        only an administrator can change a role. false : accounts are created by an administrator only.
ALLOW_SIGNUP=true

# ---------------------------------------------------------------- Demo sign-in (only when Supabase is not configured)
DEMO_PASSWORD=demo-password
# Signing key for demo sessions. Empty = a new random key on every start (sessions end on restart).
DEMO_JWT_SECRET=

# ---------------------------------------------------------------- Hospital nodes
# Secret from which each node's X-Hospital-Token is derived. Set a fixed value when using external nodes.
NODE_TOKEN_SECRET=

# ---------------------------------------------------------------- Storage
# Where the coordinator keeps global model weights. Defaults to ml/checkpoints.
MODEL_STORAGE_PATH=
# Where the in-process hospital nodes keep their local data. Defaults to data/hospitals.
HOSPITAL_DATA_ROOT=
MODEL_KEEP_VERSIONS=5

# ---------------------------------------------------------------- Surveillance (real mode)
# GeoJSON (or, with geopandas, Shapefile/GeoPackage) of region boundaries, and the property names to read.
REGIONS_GEOJSON_PATH=
REGION_ID_FIELD=region_id
REGION_NAME_FIELD=name
REGION_POPULATION_FIELD=population
# CSV of hospital-level weekly counts: hospital_id, region_id, disease, week_start, case_count[, suppressed]
SURVEILLANCE_REPORTS_CSV=
SUPPRESSION_THRESHOLD=5

# ---------------------------------------------------------------- HTTP
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_BASE_URL=http://localhost:8000
# 0.0.0.0 to accept hospital nodes and browsers from other machines.
API_HOST=127.0.0.1
API_PORT=8000
